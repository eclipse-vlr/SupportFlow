# Docker Compose reads this file. go run uses process environment variables.
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_BASE_URL=https://api.openai.com/v1
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm-flash
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
HTTP_PORT=8080
DATABASE_PORT=55433
POSTGRES_PASSWORD=supportflow_local
WORKERS=2
LLM_TIMEOUT=30s
MAX_ATTEMPTS=3
MAX_OUTPUT_TOKENS=1500
MAX_QUEUED_TICKETS=100

# Required in paid mode. One currency, integer nanounits (1 unit = 1e9 nanounits).
# Set actual provider prices per token and explicit daily / per-ticket limits.
AI_DAILY_LIMIT_NANOUNITS=
AI_TICKET_LIMIT_NANOUNITS=
AI_INPUT_RATE_NANOUNITS=
AI_OUTPUT_RATE_NANOUNITS=
